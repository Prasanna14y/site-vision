{
    "name": "sitevision/api",
    "description": "PHP endpoints for the Site Vision static site (chat assistant + quote form) on shared hosting",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "anthropic-ai/sdk": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": false
        },
        "vendor-dir": "lib/vendor"
    }
}
